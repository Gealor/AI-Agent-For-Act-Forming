// ============================================================
//  num2words-ru.typ
//  Перевод целых чисел в русские прописные слова
//  Диапазон: 0 … 999 999 999 999 (до миллиардов включительно)
// ============================================================

// ── Базовые словари ─────────────────────────────────────────

#let _ones-m = (  // мужской род (и средний)
  "", "один", "два", "три", "четыре", "пять",
  "шесть", "семь", "восемь", "девять",
)
#let _ones-f = (  // женский род (тысячи)
  "", "одна", "две", "три", "четыре", "пять",
  "шесть", "семь", "восемь", "девять",
)
#let _teens = (
  "десять", "одиннадцать", "двенадцать", "тринадцать",
  "четырнадцать", "пятнадцать", "шестнадцать",
  "семнадцать", "восемнадцать", "девятнадцать",
)
#let _tens = (
  "", "десять", "двадцать", "тридцать", "сорок",
  "пятьдесят", "шестьдесят", "семьдесят",
  "восемьдесят", "девяносто",
)
#let _hundreds = (
  "", "сто", "двести", "триста", "четыреста",
  "пятьсот", "шестьсот", "семьсот",
  "восемьсот", "девятьсот",
)

// ── Склонение существительного ──────────────────────────────
// forms = (именит.ед, родит.ед, родит.мн)
// Возвращает нужную форму по последней значащей цифре числа n.

#let _pick-form(n, forms) = {
  let r100 = calc.rem(n, 100)
  let r10  = calc.rem(n, 10)
  if r100 >= 11 and r100 <= 19 { forms.at(2) }
  else if r10 == 1              { forms.at(0) }
  else if r10 >= 2 and r10 <= 4 { forms.at(1) }
  else                          { forms.at(2) }
}

// ── Преобразование числа до 999 в слова ─────────────────────
// feminine=true — числительные в женском роде (для тысяч)

#let _tri(n, feminine) = {
  // n — целое 0..999
  let parts = ()

  let h = calc.quo(n, 100)
  let rest = calc.rem(n, 100)
  if h > 0 { parts.push(_hundreds.at(h)) }

  if rest >= 10 and rest <= 19 {
    parts.push(_teens.at(rest - 10))
  } else {
    let t = calc.quo(rest, 10)
    let o = calc.rem(rest, 10)
    if t > 0 { parts.push(_tens.at(t)) }
    if o > 0 {
      if feminine { parts.push(_ones-f.at(o)) }
      else        { parts.push(_ones-m.at(o)) }
    }
  }

  parts.join(" ")
}

// ── Главная функция ──────────────────────────────────────────

#let num2words(n) = {
  // Принимает целое неотрицательное число.
  let n = int(n)

  if n == 0 { return "ноль" }

  let neg = n < 0
  if neg { n = -n }

  let parts = ()

  // миллиарды
  let mlrd = calc.quo(n, 1000000000)
  n = calc.rem(n, 1000000000)
  if mlrd > 0 {
    parts.push(_tri(mlrd, false))
    parts.push(_pick-form(mlrd, ("миллиард", "миллиарда", "миллиардов")))
  }

  // миллионы
  let mln = calc.quo(n, 1000000)
  n = calc.rem(n, 1000000)
  if mln > 0 {
    parts.push(_tri(mln, false))
    parts.push(_pick-form(mln, ("миллион", "миллиона", "миллионов")))
  }

  // тысячи  (женский род: одна тысяча, две тысячи…)
  let tys = calc.quo(n, 1000)
  n = calc.rem(n, 1000)
  if tys > 0 {
    parts.push(_tri(tys, true))
    parts.push(_pick-form(tys, ("тысяча", "тысячи", "тысяч")))
  }

  // остаток
  if n > 0 {
    parts.push(_tri(n, false))
  }

  let result = parts.join(" ")
  if neg { result = "минус " + result }
  result
}

// ============================================================
//  Демонстрация
// ============================================================

= Перевод чисел в русские прописные

#let demo-nums = (
  0, 1, 11, 21, 100, 101, 111, 200, 999,
  1000, 1001, 1011, 1100, 2000, 5000, 11000, 21000,
  100000, 999999,
  1000000, 2000000, 5000000,
  1000000000, 2000000001, 999999999999,
  90000
)

#table(
  columns: (auto, 1fr),
  stroke: 0.5pt,
  fill: (x, y) => if y == 0 { luma(230) } else if calc.odd(y) { luma(248) },
  align: (right, left),
  [*Число*], [*Прописью*],
  ..demo-nums.map(n => (
    str(n),
    num2words(n),
  )).flatten()
)
